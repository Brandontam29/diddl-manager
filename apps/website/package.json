{
  "name": "@diddl/website",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node .output/server/index.mjs",
    "format": "oxfmt --config ../../.oxfmtrc.json .",
    "lint": "oxlint --config ../../.oxlintrc.json src scripts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "catalog:clean": "bun run scripts/clean-catalog.ts",
    "catalog:load": "bun run scripts/load-catalog.ts",
    "import:desktop": "bun run scripts/import-desktop.ts",
    "test": "bun run test:unit && bun run test:integration",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.16.10",
    "@clerk/clerk-js": "^6.29.3",
    "@clerk/ui": "^1.30.6",
    "@dnd-kit/solid": "^0.5.0",
    "@kobalte/core": "^0.13.11",
    "@neondatabase/serverless": "^1.1.0",
    "@solid-primitives/intersection-observer": "^2.2.4",
    "@solid-primitives/media": "^2.3.5",
    "@solid-primitives/scheduled": "^1.5.3",
    "@tanstack/solid-form": "^1.28.5",
    "@tanstack/solid-router": "^1.170.29",
    "@tanstack/solid-start": "^1.168.46",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-solid": "^0.441.0",
    "motion": "^12.38.0",
    "solid-icons": "^1.2.0",
    "solid-js": "^1.9.15",
    "tailwind-merge": "^2.6.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.5.4",
    "drizzle-kit": "^0.31.10",
    "image-size": "^2.0.2",
    "nitro": "^3.0.260610-beta",
    "tailwind-scrollbar": "^4.0.2",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vite": "^8.0.14",
    "vite-plugin-solid": "^2.11.11",
    "vitest": "^4.1.11"
  }
}
