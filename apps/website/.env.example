# Copy to .env.local (dev) / .env.test (integration tests). Both are gitignored.
# Neon branches: main = production, dev = local dev + Vercel previews, test = CI + local tests.

# Pooled connection string — runtime via @neondatabase/serverless + drizzle-orm/neon-http.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Direct (unpooled) connection string — drizzle-kit migrations and scripts only. Never set on Vercel.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Clerk — server-side (@clerk/backend).
CLERK_SECRET_KEY=sk_test_xxx

# Clerk — client-side (@clerk/clerk-js); the VITE_ prefix exposes it to the browser.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Base URL for catalog images, served from public/diddls/.
VITE_IMAGE_BASE_URL=/diddls
